{
  "name": "pms-la-sallito",
  "private": true,
  "description": "Recursos de frontend del PMS (Tailwind, HTMX, Alpine).",
  "scripts": {
    "vendor": "node scripts/copy-vendor.mjs",
    "build:css": "tailwindcss -i static/src/input.css -o static/css/app.css --minify",
    "watch:css": "tailwindcss -i static/src/input.css -o static/css/app.css --watch",
    "build": "npm run vendor && npm run build:css"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.2.6",
    "@fontsource/cormorant-garamond": "5.2.6",
    "@tailwindcss/forms": "0.5.10",
    "alpinejs": "3.14.9",
    "htmx.org": "2.0.6",
    "tailwindcss": "3.4.17"
  }
}
