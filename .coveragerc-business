# RNF-MAN-02: cobertura mínima de 80 % en las reglas de negocio.
[run]
source =
    apps/rates
    apps/reservations
    apps/folio
    apps/billing
    apps/frontdesk
omit =
    */migrations/*
    */tests/*
    */views.py
    */urls.py
    */admin.py
    */forms.py
    */apps.py

[report]
fail_under = 80
show_missing = False
