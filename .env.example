# Copie este archivo como .env y complete los valores. .env NUNCA se sube a Git.

DJANGO_SETTINGS_MODULE=config.settings.dev
DEBUG=True
SECRET_KEY=cambie-esto-por-una-clave-larga-y-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# --- Base de datos: Supabase (sección 13) ---------------------------------
# Supabase > Project Settings > Database > Connection string > "Session pooler"
# (puerto 5432, recomendado para Django; RF-BD-02). Ejemplo:
# DATABASE_URL=postgres://postgres.<ref-del-proyecto>:<CONTRASEÑA>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Si la deja vacía, se usa SQLite local (solo para probar rápido).
DATABASE_URL=
# Si usa el pooler en modo transacción (puerto 6543), ponga True:
DB_DISABLE_SERVER_SIDE_CURSORS=False

# Pruebas automáticas: nunca contra Supabase. Vacío = SQLite en memoria.
# (La CI de GitHub usa su propio PostgreSQL.)
TEST_DATABASE_URL=

# --- Supabase Storage (S3), RF-BD-06. Opcional ----------------------------
# Supabase > Storage > S3 Connection
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
SUPABASE_S3_BUCKET=pms-media
SUPABASE_S3_REGION=us-east-1

# --- Celery / Redis -------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=True

# --- Correo (consola en desarrollo) ---------------------------------------
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=Hotel La Sallito <no-reply@localhost>

# --- Seguridad ------------------------------------------------------------
SESSION_IDLE_SECONDS=1800
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=15

# --- PMS --------------------------------------------------------------------
# simulator | production   (sección 12: solo afecta la facturación SUNAT)
SUNAT_MODE=simulator
# Contraseña de los usuarios de práctica que crea "seed_pms --demo"
DEMO_USER_PASSWORD=

SENTRY_DSN=
